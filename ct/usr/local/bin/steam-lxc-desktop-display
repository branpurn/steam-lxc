#!/bin/bash
# Desktop Mode display setup (Plasma autostart), from /etc/default/steam-lxc: DESKTOP_OUTPUT mode/scale,
# HDR + WCG off on every output when STEAM_LXC_DISABLE_HDR=1, optionally other outputs off.
# Re-applied every login so updates can't drift it.
[ -r /etc/default/steam-lxc ] && . /etc/default/steam-lxc
sleep 4
O=${DESKTOP_OUTPUT:-}; M=${DESKTOP_MODE:-}; S=${DESKTOP_SCALE:-}
outs=$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '/^Output:/{print $3}')
args=()
if [ -n "$O" ]; then
  args+=(output.$O.enable output.$O.priority.1)
  [ -n "$M" ] && args+=(output.$O.mode.$M)
  [ -n "$S" ] && args+=(output.$O.scale.$S)
  if [ "${DESKTOP_DISABLE_OTHER_OUTPUTS:-0}" = 1 ]; then
    for d in $outs; do [ "$d" = "$O" ] || args+=(output.$d.disable); done
  fi
fi
if [ "${STEAM_LXC_DISABLE_HDR:-0}" = 1 ]; then
  for d in $outs; do args+=(output.$d.hdr.disable output.$d.wcg.disable); done
fi
[ ${#args[@]} -gt 0 ] || exit 0
kscreen-doctor "${args[@]}" 2>&1 | logger -t steam-lxc-desktop-display
