#!/bin/bash
# steam-lxc shim for SteamOS' steamosctl (steamos-manager CLI). Only the session-switch verbs are implemented.
case "${1:-}" in
  switch-to-desktop-mode) exec /usr/libexec/os-session-select plasma ;;
  switch-to-game-mode)    exec /usr/libexec/os-session-select gamescope ;;
  *) logger -t steamosctl "steam-lxc shim: '$*' not implemented"; exit 0 ;;
esac
