// Let the session user start only the steam-lxc session-switch units (Steam's "Switch to Desktop", desktop shortcut).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.user == "steam") {
        var unit = action.lookup("unit") || "";
        if (unit.indexOf("steam-lxc-switch@") == 0 && action.lookup("verb") == "start") {
            return polkit.Result.YES;
        }
    }
});
