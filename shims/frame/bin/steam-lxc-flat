#!/bin/bash
# Frame shim: optional per-game launch-option prefix, pending better Steam Frame support in SteamOS from Valve.
#   Steam > game > Properties > Launch Options:   /usr/local/lib/steam-lxc/frame/steam-lxc-flat %command%
# Stops SteamVR synchronously (same graceful path as the yield watcher) BEFORE the game starts, then runs the game.
# Treats the game as non-VR regardless of appinfo. Without FRAME_SHIM_STEAMVR_YIELD=1 it just runs the game.
. "${FRAME_SHIM_LIBEXEC:-/usr/local/lib/steam-lxc/frame}/frame-yield.sh"
if [ "${FRAME_SHIM_STEAMVR_ALWAYS_ON:-0}" = 1 ] && [ "${FRAME_SHIM_STEAMVR_YIELD:-0}" = 1 ]; then
    "$FRAME_LIBEXEC/steam-lxc-steamvr-yield" --stop-now "${SteamAppId:-${STEAM_COMPAT_APP_ID:-0}}" "$$" >/dev/null 2>&1
fi
[ $# -gt 0 ] || { echo "usage: steam-lxc-flat %command%" >&2; exit 2; }
exec "$@"   # same PID: the yield stays tied to this process until the game exits
