#!/bin/bash
# Frame shim: "SteamVR yields to flat games" watcher (steam-lxc-steamvr-yield.service, Steam user's systemd --user).
# Pending better Steam Frame support in SteamOS from Valve. Requires FRAME_SHIM_STEAMVR_ALWAYS_ON=1 and
# FRAME_SHIM_STEAMVR_YIELD=1.
#   Confirmed VR app launched (appinfo VR fields, or FRAME_SHIM_STEAMVR_YIELD_VR) -> make sure SteamVR runs.
#   Anything else (flat or unknown, or FRAME_SHIM_STEAMVR_YIELD_FLAT)          -> stop SteamVR if it runs.
# After the non-VR app exits (+ FRAME_SHIM_STEAMVR_RESUME_DELAY s) SteamVR is started again via its own unit.
# Launches are seen through Steam's per-game "reaper" process (exact comm, our UID, "AppId=<n>" in its argv), which
# exists before the game's window and before the Frame's stream type is fixed.
# Usage: steam-lxc-steamvr-yield            run the watcher
#        steam-lxc-steamvr-yield --once     one poll iteration (tests)
#        steam-lxc-steamvr-yield --stop-now APPID PID   used by steam-lxc-flat
set -u
. "${FRAME_SHIM_LIBEXEC:-/usr/local/lib/steam-lxc/frame}/frame-yield.sh"
. "$FRAME_LIBEXEC/frame-streamres.sh"
[ "${FRAME_SHIM_STEAMVR_ALWAYS_ON:-0}" = 1 ] && [ "${FRAME_SHIM_STEAMVR_YIELD:-0}" = 1 ] \
    || { echo "FRAME_SHIM_STEAMVR_ALWAYS_ON and FRAME_SHIM_STEAMVR_YIELD must be 1; nothing to do"; exit 0; }
POLL=${FRAME_SHIM_YIELD_POLL:-1}
RESUME=${FRAME_SHIM_STEAMVR_RESUME_DELAY:-15}
SYSTEMCTL=${FRAME_SHIM_SYSTEMCTL:-systemctl}
mkdir -p "$FRAME_RUN"
exec 9>"$FRAME_RUN/yield.lock"

classify() {   # prints vr|flat|unknown|ignore, cached per appid + appinfo mtime
    local app=$1 m c
    m=$(stat -c %Y "$FRAME_STEAM_ROOT/appcache/appinfo.vdf" 2>/dev/null || echo 0)
    c=$(awk -v a="$app" -v m="$m" '$1==a && $2==m {print $3; exit}' "$FRAME_RUN/vrclass" 2>/dev/null)
    if [ -z "$c" ]; then
        read -r _ c why < <("$FRAME_LIBEXEC/steam-lxc-vrclass" "$app" 2>/dev/null)
        c=${c:-unknown}
        echo "$app $m $c" >> "$FRAME_RUN/vrclass"
        flog "classify: app $app -> $c (${why:-appinfo unreadable})"
    fi
    echo "$c"
}

reapers() {    # "<pid> <appid>" for each Steam reaper of ours
    local p a
    for p in $(pgrep -u "$UID" -x reaper); do
        a=$(tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null | sed -n 's/^AppId=\([0-9]\+\)$/\1/p' | head -1)
        [ -n "$a" ] && echo "$p $a"
    done
}

start_steamvr() {   # via its own unit (Steam picks the runtime); LAUNCH_NOW skips the start delay
    touch "$LAUNCH_NOW"
    $SYSTEMCTL --user start steam-lxc-steamvr.service >/dev/null 2>&1 || flog "resume: could not start steam-lxc-steamvr.service"
}

on_launch() {   # $1 pid $2 appid
    local pid=$1 app=$2 c mark
    c=$(classify "$app")
    case "$c" in
        ignore) return ;;
        vr)
            flock 9
            if [ -f "$YIELD_FILE" ]; then yield_clear; streamres_restore; fi
            if vr_up; then flog "vr: app $app launched, SteamVR already running"
            else flog "vr: app $app launched, starting SteamVR now"; start_steamvr; fi
            flock -u 9 ;;
        *)
            flock 9
            mark=$(stream_mark)
            yield_set "$app" "$pid"
            RESUME_AT=
            if vr_up; then
                stop_steamvr "app $app is $c"
                if stream_vr_since "$mark" || [ "$(stream_state)" = vr ]; then
                    flog "yield: the Frame stream had already started on the VR path; restart the stream on the Frame (or relaunch app $app)"
                fi
            else
                flog "yield: app $app ($c) launched; SteamVR not running"
            fi
            flock -u 9 ;;
    esac
}

tick() {
    local pid app now cur a p t
    cur=$(reapers)
    while read -r pid app; do
        [ -n "$pid" ] || continue
        grep -qx "$pid" <<<"$SEEN" && continue
        SEEN=$(printf '%s\n%s' "$SEEN" "$pid")
        on_launch "$pid" "$app"
    done <<<"$cur"
    SEEN=$(grep -xF -f <(cut -d' ' -f1 <<<"$cur") <<<"$SEEN" || true)   # forget exited reapers

    [ -f "$YIELD_FILE" ] || { streamres_restore; return; }
    read -r a p t < "$YIELD_FILE"
    # Flat-stream resolution: only while yielded AND a desktop stream to the Frame is live.
    if [ "$(stream_state)" = desktop ]; then streamres_apply; else streamres_restore; fi
    if kill -0 "$p" 2>/dev/null; then RESUME_AT=; return; fi
    # Another non-VR app may still run (flat -> flat): adopt it.
    while read -r pid app; do
        [ -n "$pid" ] || continue
        [ "$(classify "$app")" = vr ] && continue; [ "$(classify "$app")" = ignore ] && continue
        yield_set "$app" "$pid"; RESUME_AT=; return
    done <<<"$cur"
    now=$(date +%s)
    [ -n "${RESUME_AT:-}" ] || { RESUME_AT=$(( now + RESUME )); flog "resume: app $a exited; SteamVR resumes in ${RESUME}s"; }
    [ "$now" -ge "$RESUME_AT" ] || return
    flock 9; yield_clear; streamres_restore; flock -u 9
    RESUME_AT=
    flog "resume: starting SteamVR again"
    rm -f "$LAUNCH_NOW"
    $SYSTEMCTL --user start steam-lxc-steamvr.service >/dev/null 2>&1 || flog "resume: could not start steam-lxc-steamvr.service"
}

case "${1:-}" in
    --stop-now)
        flock 9; yield_set "${2:-0}" "${3:-$PPID}"; stop_steamvr "steam-lxc-flat wrapper, app ${2:-?}"; exit 0 ;;
esac

# Startup: reapers already running are not "launches"; a stale yield from a previous run is dropped.
SEEN=$(reapers | cut -d' ' -f1)
RESUME_AT=
if [ -f "$YIELD_FILE" ] && ! yield_active; then yield_clear; fi
[ "${1:-}" = --once ] && { tick; exit 0; }
flog "watcher: started (resume delay ${RESUME}s, flat stream res '${STREAM_RES:-off}')"
trap 'streamres_restore; exit 0' TERM INT
while :; do tick; sleep "$POLL"; done
