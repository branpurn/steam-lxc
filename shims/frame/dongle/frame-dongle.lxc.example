# Host side (Proxmox /etc/pve/lxc/<ctid>.conf or create-ct.sh EXTRA_LXC_CONF): move the Frame Wireless Adapter into the CT.
# Rename it on the host first to a stable name (here wlframehost, e.g. with a systemd .link file matched on the USB
# adapter's MAC) so the phys passthrough survives reboots. Use a free lxc.net index.
lxc.net.1.type: phys
lxc.net.1.link: wlframehost
lxc.net.1.name: wlframe0
lxc.net.1.flags: up
