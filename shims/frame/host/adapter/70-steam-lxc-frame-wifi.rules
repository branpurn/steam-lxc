# Host: give the adapter's netdev a stable host name and hand its phy to the CT (steam-lxc-frame-wifi hotplug).
# Matches by USB vendor:product only (never by port path or MAC). Keep the NAME in sync with FRAME_HOST_IFACE_HOST.
SUBSYSTEM=="net", ACTION=="add", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="2432", NAME="wlframehost", RUN+="/usr/bin/systemd-run --no-block /usr/local/sbin/steam-lxc-frame-wifi hotplug"
