[Unit]
Description=steam-lxc Frame shim: SteamVR yields to non-VR games (pending better Steam Frame support in SteamOS)
After=default.target steam-lxc-steamvr.service

[Service]
Type=simple
# Disabled unless FRAME_SHIM_STEAMVR_ALWAYS_ON=1 and FRAME_SHIM_STEAMVR_YIELD=1 in /etc/default/steam-lxc
ExecCondition=/bin/sh -c '. /etc/default/steam-lxc 2>/dev/null; [ "$FRAME_SHIM_STEAMVR_ALWAYS_ON" = 1 ] && [ "$FRAME_SHIM_STEAMVR_YIELD" = 1 ]'
ExecStart=/usr/local/lib/steam-lxc/frame/steam-lxc-steamvr-yield
# On stop the watcher puts back a temporary gamescope mode (TERM trap); it never stops SteamVR on its own exit.
KillMode=mixed
TimeoutStopSec=15
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
