[Unit]
Description=steam-lxc Frame shim: always-on SteamVR, yields to non-VR games (pending better Steam Frame support in SteamOS)
# Started by the Steam user's systemd --user manager (the Game/Desktop session is a logind session).
After=default.target
# Session switches and vrserver crashes are handled inside the loop; a restart only follows repeated launch failures.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# On stop the loop restores a temporary gamescope mode (TERM trap). SteamVR belongs to Steam's session, not this unit.
KillMode=mixed
TimeoutStopSec=20
Type=simple
# Disabled unless FRAME_SHIM_STEAMVR_ALWAYS_ON=1 in /etc/default/steam-lxc
ExecCondition=/bin/sh -c '. /etc/default/steam-lxc 2>/dev/null; [ "$FRAME_SHIM_STEAMVR_ALWAYS_ON" = 1 ]'
ExecStartPre=-/usr/local/lib/steam-lxc/frame/vrsettings-merge lastknown
ExecStart=/usr/local/lib/steam-lxc/frame/steam-lxc-steamvr
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
