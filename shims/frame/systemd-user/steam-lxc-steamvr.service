[Unit]
Description=steam-lxc Frame shim: always-on SteamVR (pending better Steam Frame support in SteamOS)
# Started by the Steam user's systemd --user manager (the Game/Desktop session is a logind session).
After=default.target
# Each session switch costs one restart; give up only on a real crash loop.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
KillMode=mixed
TimeoutStopSec=20
Type=simple
# Disabled unless FRAME_SHIM_STEAMVR_ALWAYS_ON=1 in /etc/default/steam-lxc
ExecCondition=/bin/sh -c '. /etc/default/steam-lxc 2>/dev/null; [ "$FRAME_SHIM_STEAMVR_ALWAYS_ON" = 1 ]'
ExecStartPre=-/usr/local/lib/steam-lxc/frame/vrsettings-merge lastknown
ExecStart=/usr/local/lib/steam-lxc/frame/steam-lxc-steamvr
Restart=on-failure
# Long enough that a failing start does not flash SteamVR windows on the screen in quick succession.
RestartSec=30

[Install]
WantedBy=default.target
