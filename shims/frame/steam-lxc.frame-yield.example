# Frame shim: "SteamVR yields to non-VR games" settings. Append to /etc/default/steam-lxc (all inert unless
# FRAME_SHIM_STEAMVR_ALWAYS_ON=1 and FRAME_SHIM_STEAMVR_YIELD=1). Pending better Steam Frame support in SteamOS.
# 1 = inside steam-lxc-steamvr.service (one service): a confirmed VR game starts SteamVR at once; any other game (flat or unknown) stops it
FRAME_SHIM_STEAMVR_YIELD=0
# Appids that always count as non-VR / as VR (space or comma separated); they win over Steam's appinfo. Examples only.
FRAME_SHIM_STEAMVR_YIELD_FLAT=
FRAME_SHIM_STEAMVR_YIELD_VR=
# Seconds after the last non-VR game exits before SteamVR is started again
FRAME_SHIM_STEAMVR_RESUME_DELAY=15
# Optional extra command tried before the SIGTERMs when stopping SteamVR (none is known to work on Linux)
FRAME_SHIM_STEAMVR_YIELD_QUIT_CMD=
# Stop order: SIGTERM vrmonitor (wait MONITOR_WAIT s), then SIGTERM vrserver (wait YIELD_STOP_TIMEOUT s), then verify
# vrcompositor is gone (COMPOSITOR_WAIT s). While SteamVR runs, ALL Remote Play clients (not only the Frame) get the
# VR stream path (VR_MovieStream) and may get no video.
FRAME_SHIM_STEAMVR_MONITOR_WAIT=10
FRAME_SHIM_STEAMVR_YIELD_STOP_TIMEOUT=15
FRAME_SHIM_STEAMVR_COMPOSITOR_WAIT=10
# 1 = SIGKILL a vrserver that survived both SIGTERMs (off: it is left running and logged)
FRAME_SHIM_STEAMVR_YIELD_SIGKILL=0
# OPT-IN (default off, leave empty): gamescope output mode while a non-VR game streams (desktop stream live).
# Known to cause a top-left-quarter crop: it resizes the game's Xwayland mid-game. Stock gamescope already scales its
# PipeWire capture to the size the Remote Play client requests, so leave this empty.
FRAME_SHIM_FLAT_STREAM_RES=
# Refresh rate used when FRAME_SHIM_FLAT_STREAM_RES has no @Hz
FRAME_SHIM_FLAT_STREAM_HZ=60
# Optional: gamescope's "<Make> <Model>" of the HDMI display, if gamescopectl cannot report it
FRAME_SHIM_FLAT_STREAM_DISPLAY=
# Seconds before SteamVR is relaunched after it crashed (vrserver exited on its own)
FRAME_SHIM_STEAMVR_RELAUNCH_DELAY=30
